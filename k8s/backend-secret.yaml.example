apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: mlops
type: Opaque
stringData:
  # ==========================================
  # RDS 접속 정보
  # ==========================================
  DB_HOST: "CHANGE_ME"
  DB_PORT: "5432"
  DB_NAME: "mlops"
  DB_USER: "mlops"
  DB_PASSWORD: "CHANGE_ME"

  # ==========================================
  # 애플리케이션 보안 키 (랜덤 문자열 권장)
  # python -c "import secrets; print(secrets.token_hex(32))"
  # ==========================================
  SECRET_KEY: "CHANGE_ME"

  # ==========================================
  # 서비스 연동 URL
  # ==========================================
  MLFLOW_BASE_URL: "http://mlflow.mlops.click"
  MLFLOW_TRACKING_URI: "http://mlflow.mlflow.svc.cluster.local:80"
  MLFLOW_TRACKING_USERNAME: "CHANGE_ME"
  MLFLOW_TRACKING_PASSWORD: "CHANGE_ME"
  MLFLOW_MODEL_NAME: "CHANGE_ME"
  MLFLOW_MODEL_STAGE: "Production"

  JUPYTER_BASE_URL: "http://jupyterhub.mlops.click"
  JUPYTERHUB_JWT_SECRET: "CHANGE_ME"
  JUPYTERHUB_ADMIN_TOKEN: "CHANGE_ME"
  JUPYTER_ENVS: '[{"name":"CPU 환경","server":""},{"name":"GPU 환경","server":"gpu"}]'

  AIRFLOW_BASE_URL: "http://airflow.mlops.click"

  # ==========================================
  # AWS 설정
  # ==========================================
  AWS_REGION: "ap-northeast-2"
  AWS_DEFAULT_REGION: "ap-northeast-2"
  ATHENA_REGION: "ap-northeast-2"
  ATHENA_DATABASE: "mlops"
  ATHENA_S3_OUTPUT: "CHANGE_ME"
  S3_BUCKET_NAME: "CHANGE_ME"
  S3_REGION: "ap-northeast-2"
